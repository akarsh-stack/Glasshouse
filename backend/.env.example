ANTHROPIC_API_KEY=your_key_here

# onnx | sentence-transformers | openai
#   onnx                  all-MiniLM-L6-v2 via onnxruntime (default, no torch)
#   sentence-transformers same model via PyTorch (pip install -r requirements-torch.txt)
#   openai                text-embedding-3-small (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=onnx
# OPENAI_API_KEY=

REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:///./glasshouse.db

# --- Generation provider -----------------------------------------------------
# anthropic | openai
#   anthropic  Claude via the Anthropic SDK (default). Needs a funded account:
#              there is no free Anthropic API tier.
#   openai     any OpenAI-compatible endpoint. This is the wire format Groq,
#              Google AI Studio, OpenRouter and Ollama all speak, so one setting
#              reaches all of them. Leave LLM_BASE_URL blank for real OpenAI.
LLM_PROVIDER=anthropic
# LLM_BASE_URL=
# LLM_API_KEY=            # falls back to ANTHROPIC_API_KEY / OPENAI_API_KEY

# Blank = the provider's default for that tier. Override to pin a model.
# LLM_MODEL_FAST=
# LLM_MODEL_QUALITY=
# LLM_MODEL_DEEP=

# Free-tier recipes, verified 2026-08-28. Model ids move; check the provider's
# /models endpoint if one 404s.
#
#   Groq — no card required, fastest of the free options:
#     LLM_PROVIDER=openai
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_API_KEY=gsk_...                      # console.groq.com
#     (tier defaults are already Groq's: llama-3.1-8b-instant /
#      llama-3.3-70b-versatile / openai/gpt-oss-120b)
#
#   Google AI Studio — no card; keep billing DISABLED or the free tier vanishes:
#     LLM_PROVIDER=openai
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_API_KEY=...                          # aistudio.google.com/apikey
#     LLM_MODEL_FAST=gemini-3.1-flash-lite
#     LLM_MODEL_QUALITY=gemini-3-flash-preview
#     LLM_MODEL_DEEP=gemini-3.5-flash-lite
#     (Pro models return 429 and the 2.5 series 404s on the free plan, so all
#      three tiers are flash-family — the tiers differ, but less than on Claude.)
#
#   Ollama — fully local, no key at all:
#     LLM_PROVIDER=openai
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_API_KEY=ollama
#     LLM_MODEL_FAST=llama3.2

# Tier used when a query carries no hint. Long queries are promoted one step.
LLM_DEFAULT_TIER=quality
LLM_MAX_TOKENS=2048

# structural | fixed
#   structural  split on headings, never across a section (default)
#   fixed       220-word windows — the approach ADR-006 rejected, kept
#               selectable so its measurements can be reproduced
CHUNKER=structural

# Browser origins allowed to call the API, comma separated. A production build
# served by this same process needs none. "*" opts back into wide-open CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ingestion holds the whole upload in memory and runs the embedding model over
# it, so it is capped and charged more tokens than a query.
MAX_UPLOAD_BYTES=20971520
UPLOAD_TOKEN_COST=25
